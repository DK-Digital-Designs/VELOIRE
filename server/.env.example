# Server Configuration
PORT=3000
NODE_ENV=production

# Security
# URL of the frontend (e.g., https://veloire.vercel.app)
FRONTEND_URL=http://localhost:5173
# Secret key for JWT signing (generate a random strong string)
JWT_SECRET=replace_with_secure_random_string

# Database
# Connect string for PostgreSQL (e.g. from Neon.tech, Render, etc.)
DATABASE_URL="postgresql://user:password@host:5432/veloire_db"

# Optional: Mail / Notifications (If added later)
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASS=
